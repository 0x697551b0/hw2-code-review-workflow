# 编排器环境变量示例
# 用法：复制为 .env 后填写，或直接在 shell 里 export。
# 注意 .env 已在 .gitignore 中，切勿把真实密钥提交到仓库。

# ---- 输入输出 ----
# 需求文件（run 命令通常直接用 --spec 传）
WF_SPEC_PATH=demo/spec_user_store.md
# 运行产物根目录，每次运行会在其下建 <run-id>/ 目录
WF_OUTPUT_ROOT=./runs

# ---- Agent 发现 ----
# 三个 Agent 仓库所在目录；留空则自动搜索（当前目录、本仓库、上级目录及其子目录）
# WF_AGENTS_HOME=..

# ---- 质量门禁 ----
WF_BLOCKING=critical,high
WF_MAX_ROUNDS=3
WF_PATTERNS=*.py

# ---- 观测 ----
# 是否实时打印执行轨迹
WF_TRACE=0
# 是否在阶段间存档（关掉会失去 resume 能力）
WF_CHECKPOINT=1

# ---- 单个 Agent 的透传选项 ----
# 语法：KEY=VALUE;KEY=VALUE
WF_CODING_OPTIONS=engine=offline;profile=realistic
WF_REVIEW_OPTIONS=mode=static;parallel=4
WF_FIX_OPTIONS=engine=rules
# 调用方式：inproc（进程内，默认）/ subprocess（子进程 JSON 往返）
WF_CODING_TRANSPORT=inproc
WF_REVIEW_TRANSPORT=inproc
WF_FIX_TRANSPORT=inproc
